{
  "name": "midiwire",
  "version": "0.3.1",
  "description": "Declarative JavaScript library for browser-based MIDI control",
  "type": "module",
  "main": "./dist/midiwire.umd.js",
  "module": "./dist/midiwire.es.js",
  "exports": {
    ".": {
      "import": "./dist/midiwire.es.js",
      "require": "./dist/midiwire.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest run --coverage && open coverage/index.html",
    "lint": "biome check --write",
    "docs": "documentation build src/index.js -f md -o docs/API.md --markdown-toc-max-depth 2"
  },
  "keywords": [
    "midiwire",
    "midi",
    "webmidi",
    "wire",
    "controller",
    "synth",
    "synthesizer",
    "cc",
    "control-change",
    "sysex",
    "audio",
    "music"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexferl/midiwire.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@vitest/coverage-v8": "4.0.17",
    "@vitest/ui": "4.0.17",
    "documentation": "14.0.3",
    "jsdom": "27.4.0",
    "vite": "7.3.1",
    "vitest": "4.0.17"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
