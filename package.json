{
  "name": "midiwire",
  "version": "0.11.1",
  "description": "Declarative JavaScript library for browser-based MIDI control",
  "type": "module",
  "main": "./dist/midiwire.umd.js",
  "module": "./dist/midiwire.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/midiwire.es.js",
      "require": "./dist/midiwire.umd.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "coverage:ui": "vitest run --coverage && open coverage/index.html",
    "lint": "biome check --write",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
    "midiwire",
    "midi",
    "webmidi",
    "wire",
    "controller",
    "synth",
    "synthesizer",
    "cc",
    "control-change",
    "sysex",
    "audio",
    "music"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexferl/midiwire.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@jsdoc/cli": "0.3.12",
    "@vitest/coverage-v8": "4.0.17",
    "@vitest/ui": "4.0.17",
    "jsdoc": "4.0.5",
    "jsdom": "27.4.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.0.17"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
